<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>


    <ItemGroup>
      <ProjectReference Include="..\PokeSeats.UI.PluginContracts\PokeSeats.UI.PluginContracts.csproj" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Assets\chenjintang-shrimp.png" LogicalName="PokeSeats.UI.DefaultWorkspace.Assets.chenjintang-shrimp.png" />
      <EmbeddedResource Include="Assets\sectl.jpg" LogicalName="PokeSeats.UI.DefaultWorkspace.Assets.sectl.jpg" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="WorkspaceStrings.resx">
        <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
        <StronglyTypedClassName>WorkspaceStrings</StronglyTypedClassName>
        <StronglyTypedNamespace>$(RootNamespace)</StronglyTypedNamespace>
        <StronglyTypedFileName>$(IntermediateOutputPath)WorkspaceStrings.Designer.cs</StronglyTypedFileName>
      </EmbeddedResource>
    </ItemGroup>

</Project>
