<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SECTL 思拓创联</Company>
        <Product>PokeSeats 戳座</Product>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
      <PackageReference Include="Silk.NET" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
      <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
      <PackageReference Include="StbImageSharp" Version="2.30.16" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Fonts\Assets\HarmonyOS_Sans_SC_Regular.ttf" LogicalName="PokeSeats.UI.Fonts.Assets.HarmonyOS_Sans_SC_Regular.ttf" />
      <None Include="Fonts\Assets\LICENSE_Fonts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PokeSeats.UI.PluginContracts\PokeSeats.UI.PluginContracts.csproj" />
      <ProjectReference Include="..\PokeSeats.UI.DefaultWorkspace\PokeSeats.UI.DefaultWorkspace.csproj" ReferenceOutputAssembly="false" />
      <ProjectReference Include="..\PokeSeats.UI.DefaultPayload\PokeSeats.UI.DefaultPayload.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="GetBuiltinPluginFiles" DependsOnTargets="ResolveProjectReferences">
      <MSBuild Projects="..\PokeSeats.UI.DefaultWorkspace\PokeSeats.UI.DefaultWorkspace.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier">
        <Output TaskParameter="TargetOutputs" ItemName="BuiltinPluginAssembly" />
      </MSBuild>
      <ItemGroup>
        <BuiltinPluginFiles Include="@(BuiltinPluginAssembly)" />
        <BuiltinPluginFiles Include="..\PokeSeats.UI.DefaultWorkspace\plugin.json" />
      </ItemGroup>
    </Target>

    <Target Name="CopyBuiltinPlugin" AfterTargets="Build" DependsOnTargets="GetBuiltinPluginFiles">
      <Copy SourceFiles="@(BuiltinPluginFiles)" DestinationFolder="$(TargetDir)builtins\pokeseats.default" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishBuiltinPlugin" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="GetBuiltinPluginFiles">
      <ItemGroup>
        <ResolvedFileToPublish Include="@(BuiltinPluginFiles)">
          <RelativePath>builtins\pokeseats.default\%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <Target Name="GetBuiltinPayloadFiles" DependsOnTargets="ResolveProjectReferences">
      <!-- A project reference with ReferenceOutputAssembly="false" is not rebuilt per RID, so the
           payload's native assets must be produced explicitly for the requested runtime. -->
      <MSBuild Condition="'$(RuntimeIdentifier)' != ''"
               Projects="..\PokeSeats.UI.DefaultPayload\PokeSeats.UI.DefaultPayload.csproj"
               Targets="Build" />
      <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\**\*" />
      </ItemGroup>
      <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*" />
      </ItemGroup>
      <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*"
                             Exclude="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\libz3.dll" />
      </ItemGroup>
      <ItemGroup>
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\plugin.json" />
      </ItemGroup>
    </Target>

    <Target Name="CopyBuiltinPayload" AfterTargets="Build" DependsOnTargets="GetBuiltinPayloadFiles">
      <Copy SourceFiles="@(BuiltinPayloadFiles)" DestinationFiles="@(BuiltinPayloadFiles->'$(TargetDir)builtins\pokeseats.defaultpayload\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishBuiltinPayload" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="GetBuiltinPayloadFiles">
      <ItemGroup>
        <ResolvedFileToPublish Include="@(BuiltinPayloadFiles)">
          <RelativePath>builtins\pokeseats.defaultpayload\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <!--
      Microsoft.Z3.x64 的 build 目标无条件把 Windows 版 libz3.dll 带进任何平台的输出。
      非 Windows 包用不上它，Linux 的原生库由 runtimes/ubuntu-x64 提供，这里统一剔掉。
    -->
    <Target Name="DropWindowsZ3NativeFromUnixPackage"
            AfterTargets="ComputeResolvedFilesToPublishList"
            Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">
      <ItemGroup>
        <_WindowsZ3Native Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)' == 'libz3' and '%(ResolvedFileToPublish.Extension)' == '.dll'" />
        <ResolvedFileToPublish Remove="@(_WindowsZ3Native)" />
      </ItemGroup>
    </Target>

</Project>
