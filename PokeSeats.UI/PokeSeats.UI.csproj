<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SECTL 思拓创联</Company>
        <Product>PokeSeats 戳座</Product>
        <ApplicationIcon>Assets\PokeSeats.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')">
      <D3DCompilerPath Condition="'$(D3DCompilerPath)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\Redist\D3D\x64\d3dcompiler_47.dll</D3DCompilerPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(D3DCompilerPath)' != '' and ($(RuntimeIdentifier.StartsWith('win')) or '$(RuntimeIdentifier)' == '')">
      <None Include="$(D3DCompilerPath)" Link="d3dcompiler_47.dll"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="RequireD3DCompiler" BeforeTargets="PrepareForBuild"
            Condition="'$(DesignTimeBuild)' != 'true' and ($(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'))">
      <Error Condition="!Exists('$(D3DCompilerPath)')"
             Text="Missing x64 d3dcompiler_47.dll. Install the Windows SDK or set -p:D3DCompilerPath to its Redist/D3D/x64/d3dcompiler_47.dll." />
    </Target>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
      <PackageReference Include="Silk.NET" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
      <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
      <PackageReference Include="StbImageSharp" Version="2.30.16" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Assets\PokeSeats.png" LogicalName="PokeSeats.UI.Assets.PokeSeats.png" />
      <None Update="Assets\PokeSeats.svg;Assets\PokeSeats.png;Assets\PokeSeats.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <EmbeddedResource Include="Fonts\Assets\HarmonyOS_Sans_SC_Regular.ttf" LogicalName="PokeSeats.UI.Fonts.Assets.HarmonyOS_Sans_SC_Regular.ttf" />
      <None Include="Fonts\Assets\LICENSE_Fonts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PokeSeats.UI.PluginContracts\PokeSeats.UI.PluginContracts.csproj" />
      <ProjectReference Include="..\PokeSeats.UI.DefaultWorkspace\PokeSeats.UI.DefaultWorkspace.csproj" ReferenceOutputAssembly="false" />
      <ProjectReference Include="..\PokeSeats.UI.DefaultPayload\PokeSeats.UI.DefaultPayload.csproj" ReferenceOutputAssembly="false" />
      <ProjectReference Include="..\PokeSeats.UI.Betapayload\PokeSeats.UI.Betapayload.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="GetBuiltinPluginFiles" DependsOnTargets="ResolveProjectReferences">
      <MSBuild Projects="..\PokeSeats.UI.DefaultWorkspace\PokeSeats.UI.DefaultWorkspace.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier">
        <Output TaskParameter="TargetOutputs" ItemName="BuiltinPluginAssembly" />
      </MSBuild>
      <ItemGroup>
        <BuiltinPluginFiles Include="@(BuiltinPluginAssembly)" />
        <BuiltinPluginFiles Include="..\PokeSeats.UI.DefaultWorkspace\plugin.json" />
      </ItemGroup>
    </Target>

    <Target Name="CopyBuiltinPlugin" AfterTargets="Build" DependsOnTargets="GetBuiltinPluginFiles">
      <Copy SourceFiles="@(BuiltinPluginFiles)" DestinationFolder="$(TargetDir)builtins\pokeseats.default" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishBuiltinPlugin" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="GetBuiltinPluginFiles">
      <ItemGroup>
        <ResolvedFileToPublish Include="@(BuiltinPluginFiles)">
          <RelativePath>builtins\pokeseats.default\%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <Target Name="GetBuiltinPayloadFiles" DependsOnTargets="ResolveProjectReferences">
      <!-- A project reference with ReferenceOutputAssembly="false" is not rebuilt per RID, so the
           payload's native assets must be produced explicitly for the requested runtime.
           SelfContained is dropped because the payload runs inside the host process: letting it
           flow through would copy a second copy of the .NET runtime into the plugin folder. -->
      <MSBuild Condition="'$(RuntimeIdentifier)' != ''"
               Projects="..\PokeSeats.UI.DefaultPayload\PokeSeats.UI.DefaultPayload.csproj"
               Targets="Build"
               RemoveProperties="SelfContained" />
      <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\**\*"
                             Exclude="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\**\*.xml;..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\**\*.pdb" />
      </ItemGroup>
      <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*"
                             Exclude="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*.xml;..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*.pdb" />
      </ItemGroup>
      <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*"
                             Exclude="..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\libz3.dll;..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*.xml;..\PokeSeats.UI.DefaultPayload\bin\$(Configuration)\net6.0\$(RuntimeIdentifier)\**\*.pdb" />
      </ItemGroup>
      <ItemGroup>
        <BuiltinPayloadFiles Include="..\PokeSeats.UI.DefaultPayload\plugin.json" />
      </ItemGroup>
    </Target>

    <Target Name="CopyBuiltinPayload" AfterTargets="Build" DependsOnTargets="GetBuiltinPayloadFiles">
      <Copy SourceFiles="@(BuiltinPayloadFiles)" DestinationFiles="@(BuiltinPayloadFiles->'$(TargetDir)builtins\pokeseats.defaultpayload\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishBuiltinPayload" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="GetBuiltinPayloadFiles">
      <ItemGroup>
        <ResolvedFileToPublish Include="@(BuiltinPayloadFiles)">
          <RelativePath>builtins\pokeseats.defaultpayload\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <Target Name="GetBuiltinBetapayloadFiles" DependsOnTargets="ResolveProjectReferences">
      <MSBuild Projects="..\PokeSeats.UI.Betapayload\PokeSeats.UI.Betapayload.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier">
        <Output TaskParameter="TargetOutputs" ItemName="BuiltinBetapayloadAssembly" />
      </MSBuild>
      <ItemGroup>
        <BuiltinBetapayloadFiles Include="@(BuiltinBetapayloadAssembly)" />
        <BuiltinBetapayloadFiles Include="..\PokeSeats.UI.Betapayload\plugin.json" />
      </ItemGroup>
    </Target>

    <Target Name="CopyBuiltinBetapayload" AfterTargets="Build" DependsOnTargets="GetBuiltinBetapayloadFiles">
      <Copy SourceFiles="@(BuiltinBetapayloadFiles)" DestinationFolder="$(TargetDir)builtins\pokeseats.betapayload" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishBuiltinBetapayload" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="GetBuiltinBetapayloadFiles">
      <ItemGroup>
        <ResolvedFileToPublish Include="@(BuiltinBetapayloadFiles)">
          <RelativePath>builtins\pokeseats.betapayload\%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <!--
      Microsoft.Z3.x64 的 build 目标无条件把 Windows 版 libz3.dll 带进任何平台的输出。
      非 Windows 包用不上它，Linux 的原生库由 runtimes/ubuntu-x64 提供，这里统一剔掉。
    -->
    <Target Name="DropWindowsZ3NativeFromUnixPackage"
            AfterTargets="ComputeResolvedFilesToPublishList"
            Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">
      <ItemGroup>
        <_WindowsZ3Native Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)' == 'libz3' and '%(ResolvedFileToPublish.Extension)' == '.dll'" />
        <ResolvedFileToPublish Remove="@(_WindowsZ3Native)" />
      </ItemGroup>
    </Target>

    <!-- 发布目录是给用户的下载产物，符号文件和 XML 文档只在开发时有用。 -->
    <Target Name="DropDevelopmentFilesFromPublish"
            AfterTargets="ComputeResolvedFilesToPublishList">
      <ItemGroup>
        <_DevelopmentFile Include="@(ResolvedFileToPublish)"
                          Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' or '%(ResolvedFileToPublish.Extension)' == '.xml'" />
        <ResolvedFileToPublish Remove="@(_DevelopmentFile)" />
      </ItemGroup>
    </Target>

</Project>
